<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.fxsuite</groupId>
    <artifactId>web-launcher</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <description>
        The web half of the FxSuite proof-of-concept: a few plain HTML pages and the
        token/catalogue API, served by ja-http's Vert.x host. Its launch page asks the
        API for a signed fxsuite-&lt;env&gt;://launch/&lt;id&gt; link and hands it to the
        OS, which invokes that environment's launcher and opens a native JavaFX window.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Released ja-http, resolvable from Maven Central. -->
        <ja-http.version>0.1.0</ja-http.version>
        <server.main>com.example.fxsuite.web.WebLauncherServer</server.main>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.captainssingapura-hue.tong.ja-http</groupId>
            <artifactId>vertx-host</artifactId>
            <version>${ja-http.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${server.main}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
